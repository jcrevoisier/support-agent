OPENAI_API_KEY=
LLM_MODEL=openai:gpt-5.4-mini
# Options passed to the model, as JSON. Defaults to {"reasoning_effort": "none"} for openai: models, {} otherwise.
# LLM_MODEL_OPTIONS={"reasoning_effort": "none"}
# Model that searches the shop policies. The default is an OpenAI model, so it needs OPENAI_API_KEY.
# EMBEDDING_MODEL=openai:text-embedding-3-small
# Voice mode (--voice) always uses OpenAI, so it needs OPENAI_API_KEY even with another LLM_MODEL.
# STT_MODEL=gpt-4o-mini-transcribe
# TTS_MODEL=gpt-4o-mini-tts
